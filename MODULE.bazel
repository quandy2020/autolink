"""Standalone Bazel module for Autolink middleware."""

module(
    name = "autolink",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")

# Align with root autonomy MODULE.bazel (not docker /usr/local 3.19).
bazel_dep(
    name = "protobuf",
    version = "30.2",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "glog",
    version = "0.6.0",
    repo_name = "com_github_google_glog",
)
bazel_dep(name = "tinyxml2", version = "10.0.0")

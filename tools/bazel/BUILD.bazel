"""Autolink Bazel toolchains: BCR deps + small system shims."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "system_libs.bzl",
])

# Prefer BCR (same pins as root //autonomy) over /usr/local CMake SDKs.
alias(
    name = "glog",
    actual = "@com_github_google_glog//:glog",
)

alias(
    name = "protobuf",
    actual = "@com_google_protobuf//:protobuf",
)

cc_library(
    name = "pthread",
    linkopts = ["-lpthread"],
    linkstatic = True,
)

cc_library(
    name = "atomic",
    linkopts = ["-latomic"],
    linkstatic = True,
)

cc_library(
    name = "dl",
    linkopts = ["-ldl"],
    linkstatic = True,
)

cc_library(
    name = "curses",
    linkopts = [
        "-lncurses",
        "-lform",
    ],
    linkstatic = True,
)

"""Standalone Bazel build for Autolink middleware."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Generated conf.hpp  (#include "autolink/conf/conf.hpp")
# ---------------------------------------------------------------------------

genrule(
    name = "generate_conf",
    srcs = ["autolink/conf/conf.hpp.in"],
    outs = ["autolink/conf/conf.hpp"],
    cmd = """
      conf_dir=$$(cd $$(dirname $(location autolink/conf/conf.hpp.in)) && pwd)
      sed \
        -e "s|@AUTOLINK_DEFAULT_CONF_DIR@|$$conf_dir|" \
        -e 's|@CMAKE_INSTALL_PREFIX@|/usr/local|' \
        -e 's|@AUTOLINK_DEFAULT_PLUGIN_INDEX_DIR@|/usr/local/share/autolink_plugin_index|' \
        $(location autolink/conf/conf.hpp.in) > $@
    """,
)

cc_library(
    name = "conf",
    hdrs = [":generate_conf"],
)

filegroup(
    name = "conf_files",
    srcs = glob(["autolink/conf/**/*.conf"], allow_empty = True),
)

# ---------------------------------------------------------------------------
# Generated protobuf  (#include "autolink/proto/*.pb.h")
# ---------------------------------------------------------------------------

PROTO_FILES = glob(["autolink/proto/*.proto"])
PROTO_HDRS = [f.replace(".proto", ".pb.h") for f in PROTO_FILES]
PROTO_SRCS = [f.replace(".proto", ".pb.cc") for f in PROTO_FILES]

genrule(
    name = "generate_protos",
    srcs = PROTO_FILES,
    outs = PROTO_HDRS + PROTO_SRCS,
    # BCR protoc so *.pb.h match @com_google_protobuf headers (not /usr/local 3.19).
    # Imports are bare filenames (e.g. scheduler_conf.proto) → --proto_path=autolink/proto.
    cmd = """
      set -euo pipefail
      PROTOC="$$(realpath "$(location @com_google_protobuf//:protoc)")"
      OUT="$$(realpath "$(@D)")/autolink/proto"
      FIRST="$$(echo $(SRCS) | awk '{print $$1}')"
      PROTO_DIR="$$(cd "$$(dirname "$${FIRST}")" && pwd)"
      mkdir -p "$${OUT}"
      (
        cd "$${PROTO_DIR}"
        "$${PROTOC}" --proto_path=. --cpp_out="$${OUT}" *.proto
      )
    """,
    tools = ["@com_google_protobuf//:protoc"],
)

cc_library(
    name = "protos",
    srcs = PROTO_SRCS,
    hdrs = PROTO_HDRS,
    includes = ["."],
    deps = ["//tools/bazel:protobuf"],
)

# ---------------------------------------------------------------------------
# Core library
# ---------------------------------------------------------------------------

CORE_EXCLUDES = [
    "**/*_test.cpp",
    "autolink/tools/**",
    "autolink/mainboard/**",
    "**/example/**",
    "**/integration_test/**",
    "autolink/python/**",
    "autolink/transport/rtps/**",
    "autolink/transport/dispatcher/rtps_dispatcher.cpp",
    "autolink/service_discovery/rtps_topology_backend.cpp",
]

cc_library(
    name = "autolink",
    srcs = glob(
        ["autolink/**/*.cpp"],
        exclude = CORE_EXCLUDES,
    ) + [
        # No Fast DDS in this build; keep the security shim only.
        "autolink/transport/rtps/security_config.cpp",
    ] + select({
        "@platforms//cpu:aarch64": ["autolink/croutine/detail/swap_aarch64.S"],
        "//conditions:default": ["autolink/croutine/detail/swap_x86_64.S"],
    }),
    hdrs = glob(
        [
            "autolink/**/*.hpp",
            "autolink/**/*.h",
        ],
        exclude = [
            "**/test/**",
            "autolink/conf/conf.hpp",
        ],
        allow_empty = True,
    ),
    includes = ["."],
    deps = [
        ":conf",
        ":protos",
        "//tools/bazel:atomic",
        "//tools/bazel:dl",
        "//tools/bazel:glog",
        "//tools/bazel:protobuf",
        "//tools/bazel:pthread",
        ":pugixml",
    ],
)

alias(
    name = "cli11",
    actual = "//thirdparty/CLI11:cli11",
)

# Header-only YAML (git submodule → thirdparty/fkYAML, branch develop).
cc_library(
    name = "fkYAML",
    hdrs = glob(["thirdparty/fkYAML/include/**/*.hpp"]),
    includes = ["thirdparty/fkYAML/include"],
)

# Header-only XML (git submodule → thirdparty/pugixml).
cc_library(
    name = "pugixml",
    hdrs = ["thirdparty/pugixml/src/pugixml.hpp"],
    includes = ["thirdparty/pugixml/src"],
    textual_hdrs = ["thirdparty/pugixml/src/pugixml.cpp"],
    defines = ["PUGIXML_HEADER_ONLY"],
)

# ---------------------------------------------------------------------------
# Recorder player  (used by Autoviz playback; not part of core :autolink)
# ---------------------------------------------------------------------------

cc_library(
    name = "recorder_player",
    srcs = glob(["autolink/tools/recorder/player/*.cpp"]),
    hdrs = glob(["autolink/tools/recorder/player/*.hpp"]),
    deps = [":autolink"],
)

# ---------------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------------

cc_binary(
    name = "mainboard",
    srcs = glob([
        "autolink/mainboard/*.cpp",
        "autolink/mainboard/*.hpp",
    ]),
    deps = [
        ":autolink",
        ":cli11",
    ],
)

cc_binary(
    name = "autolink_cli",
    srcs = ["autolink/tools/main.cpp"] + glob(
        [
            "autolink/tools/cli/*.cpp",
            "autolink/tools/cli/*.hpp",
            "autolink/tools/recorder/**/*.cpp",
            "autolink/tools/recorder/**/*.hpp",
            "autolink/tools/monitor/**/*.cpp",
            "autolink/tools/monitor/**/*.hpp",
        ],
        exclude = ["**/main.cpp"],
    ),
    deps = [
        ":autolink",
        ":cli11",
        ":pugixml",
        "//tools/bazel:curses",
    ],
)
